# ============================================================
# SHREEKUNJA OPTICAL 2.0 — Environment Variables (TEMPLATE)
# Copy to ".env" for local dev. On Vercel, add each of these in
# Project Settings -> Environment Variables. NEVER commit ".env".
# ============================================================

# --- Server ---
PORT=5050
NODE_ENV=development
# Same-origin on Vercel, so this can stay "*" or be your site URL.
# Comma-separated list allowed, e.g. https://shreekunja.com,https://www.shreekunja.com
ALLOWED_ORIGIN=http://localhost:5050

# --- Database (PostgreSQL: Neon / Supabase / Render / Vercel Postgres) ---
DATABASE_URL=postgres://user:password@host:5432/shreekunja_optical
DATABASE_SSL=true

# --- Auth / Sessions (generate each with: openssl rand -hex 64) ---
JWT_SECRET=replace-with-64-byte-random-hex
JWT_EXPIRES_IN=7d
SESSION_SECRET=replace-with-another-64-byte-random-hex
# "true" on https (Vercel). Use "false" only for plain http://localhost.
COOKIE_SECURE=false

# --- Shreekunja AI (Gemini) ---
GEMINI_API_KEY=your-gemini-api-key
GEMINI_MODEL=gemini-2.5-flash

# --- Object / Cloud Storage (not implemented yet — see services/storageService.js) ---
STORAGE_PROVIDER=
STORAGE_API_KEY=
STORAGE_SECRET=
STORAGE_BUCKET=
STORAGE_REGION=

# --- WhatsApp (optional; blank keeps the wa.me deep-link flow) ---
WHATSAPP_BUSINESS_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=

# --- First-run admin seed (npm run seed). Remove passwords afterwards. ---
ADMIN_1_NAME=Dipesh Kharel
ADMIN_1_ROLE=SUPER_ADMIN
ADMIN_1_EMAIL=
ADMIN_1_PASSWORD=

ADMIN_2_NAME=Durga Kharel
ADMIN_2_ROLE=ADMIN
ADMIN_2_EMAIL=
ADMIN_2_PASSWORD=

ADMIN_3_NAME=Devi Prasad Kharel
ADMIN_3_ROLE=ADMIN
ADMIN_3_EMAIL=
ADMIN_3_PASSWORD=

ALLOW_ADMIN_SEED=false
